{
  "name": "@rufdiamond/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "drawings:cleanup": "tsx src/worker/drawing-cleanup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1128.0",
    "@aws-sdk/s3-request-presigner": "3.1128.0",
    "@fastify/cookie": "^10.0.1",
    "@rufdiamond/contracts": "*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "pg": "^8.23.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "testcontainers": "12.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
