# Placeholder-only, server-side Fastify configuration. Never load into Next.
# Provision separate staging and production databases, buckets and credentials.
# Runtime must not use the migration owner. See admin-native-integration.md.
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://RUNTIME_USER:REPLACE_ME@db-staging.example.invalid/ruf_staging
SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
WEB_ORIGIN=https://parts-staging.example.invalid
ALLOW_INSECURE_LOOPBACK_COOKIE=false
DELIVERY_ENCRYPTION_KEY_ID=staging-v1
DELIVERY_ENCRYPTION_KEYS_JSON={"staging-v1":"REPLACE_WITH_CANONICAL_BASE64_32_BYTE_KEY"}
S3_PROVIDER=s3
S3_ENDPOINT=https://private-storage.example.invalid
S3_REGION=REPLACE_WITH_PROVIDER_REGION
S3_BUCKET=REPLACE_WITH_PRIVATE_VERSIONED_STAGING_BUCKET
S3_ACCESS_KEY_ID=REPLACE_WITH_SCOPED_STORAGE_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SCOPED_STORAGE_SECRET
DRAWING_SCANNER_HOST=scanner.internal.example.invalid
DRAWING_SCANNER_PORT=3310
DRAWING_SCANNER_TIMEOUT_MS=30000
# Production scanner needs current verified signatures and monitored health.
# Storage PUT CORS must permit only WEB_ORIGIN and required content-type header.
# Never use test fixture credentials or its single synthetic scanner signature.
