# Server-only Next settings. Placeholder values; do not add NEXT_PUBLIC_ prefixes.
# Customer pages use the authenticated API in this mode. Do not expose connected
# staging until independent Task9b review and Task9c browser/admin acceptance pass.
RUF_REPOSITORY_MODE=api
RUF_DEPLOYMENT_ENV=staging
RUF_API_UPSTREAM_URL=https://api-staging.example.invalid
RUF_WEB_ORIGIN=https://parts-staging.example.invalid
# The separately running API WEB_ORIGIN must exactly equal RUF_WEB_ORIGIN.
# Local testing may use explicit HTTP loopback origins on separate unused ports.
# Never load apps/api/.env.local into isolated tests; it contains remote secrets.
# Optional separate Next build directory (relative to the frontend root):
# RUF_NEXT_DIST_DIR=tmp/next-customer-build
# Package API builds with tools/package-api-frontend.mjs; see frontend-customer-boundary.md.
