{
  "name": "rufdiamond-parts-portal",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "node tools/build-frontend-contracts.mjs",
    "prebuild": "node tools/build-frontend-contracts.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:callout-preview": "vitest run --config vitest.callouts.config.mts",
    "test:diagram-browser": "playwright test --config playwright.diagram.config.ts",
    "test:contracts": "npm test -w @rufdiamond/contracts",
    "test:api": "npm test -w @rufdiamond/api",
    "test:web": "npm test -w @rufdiamond/web",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "import": "tsx src/import/run.ts",
    "import:tables": "tsx src/import/load-tables.ts",
    "import:callouts": "tsx src/import/vision-callouts.ts",
    "verify": "tsx src/import/verify.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
